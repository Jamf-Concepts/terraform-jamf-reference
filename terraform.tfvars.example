# Regional API gateway URL. Pick the one matching your environment's region.
# US:   https://us.api.jamfcloud.com
# EU:   https://eu.api.jamfcloud.com
# APAC: https://apac.api.jamfcloud.com
jamfplatform_base_url = ""

# Your platform environment UUID. The Integration details panel at
# account.jamf.com shows it.
jamfplatform_environment_id = ""

# Client ID and secret are not set here. Export them as TF_VAR_ environment
# variables. See Configure credentials in README.md.
